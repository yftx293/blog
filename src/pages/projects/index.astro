---
import PageLayout from '@/layouts/CommonPage.astro'
import GitHubContributions from '@/components/projects/GitHubContributions.astro'
import ProjectReferences from '@/components/projects/ProjectReferences.astro'
import ProjectSection from '@/components/projects/ProjectSection.astro'

export const prerender = true

const headings = [
  { depth: 2, slug: 'projects', text: 'Projects' },
  { depth: 2, slug: 'learnings', text: 'Learnings' },
  { depth: 2, slug: 'theme', text: 'Theme' }
]
---

<PageLayout title='Projects' {headings} info={{ slug: '/projects', hideComment: true }}>
  <p>GitHub 活动</p>
  <GitHubContributions username='yftx293' />

  <h2 id='projects'>Projects</h2>
  <p>这里记录仍在探索、迭代或值得继续回看的项目。</p>
  <ProjectSection
    analyticsSection='projects'
    showFullDescription
    project={[
      {
        id: 'ai-native-crm',
        name: 'AiNativeCrm',
        description:
          '以 CRM 为状态空间的 Agent 原生工作台。围绕客户、商机与任务，探索 Agent 如何在权限、审批和预算边界内调用工具推进业务；保留知识、记忆、执行回放与评测之间的工程取舍。',
        links: [{ type: 'github', href: 'https://github.com/yftx293/AiNativeCrm' }]
      },
      {
        id: 'miniclaw',
        name: 'miniclaw',
        description:
          '自托管、Pi Agent 驱动的多渠道智能体工作台。探索工作区、持久会话、记忆与工具权限如何支撑长期运行，并让 Web、桌面端和消息渠道复用同一套运行时；保留执行边界与后台任务的系统实践。',
        links: [
          {
            type: 'github',
            href: 'https://github.com/yftx293/miniclaw'
          }
        ]
      },
      {
        id: 'folio',
        name: 'folio',
        description:
          '本地优先的 AI 投资研究工作台。探索如何把行情数据、Agent 与证据关联到研究报告，并持续追踪论点变化；保留能力注册、离线回退和评测的工程实践。它是只读研究工具，不提供下单或交易能力。',
        links: [
          {
            type: 'github',
            href: 'https://github.com/yftx293/folio'
          }
        ]
      }
    ]}
  />
  <ProjectReferences />
</PageLayout>
