---
export const prerender = true
import PageLayout from '@/layouts/CommonPage.astro'
import GitHubContributions from '@/components/projects/GitHubContributions.astro'
import ProjectSection from '@/components/projects/ProjectSection.astro'

const headings = [{ depth: 2, slug: 'projects', text: 'Projects' }]
---

<PageLayout title='Projects' {headings} info={{ slug: '/projects', hideComment: true }}>
  <p>GitHub 活动</p>
  <GitHubContributions username='yftx293' />

  <h2 id='projects'>Projects</h2>
  <p>这里记录仍在探索、迭代或值得继续回看的项目。</p>
  <ProjectSection
    analyticsSection='projects'
    showFullDescription
    project={[
      {
        id: 'tinycode',
        name: 'tinycode',
        description:
          '基于 Pi Agent Core 的轻量级 TypeScript Coding Agent。我在这里探索 CLI、权限、会话、Context、Skills、MCP 与只读子 Agent 如何协作；它保留了这些工程取舍的迭代过程。',
        links: [{ type: 'github', href: 'https://github.com/yftx293/tinycode' }]
      },
      {
        id: 'enterprise_customer_service_agentic_rag',
        name: 'enterprise-customer-service-agentic-rag',
        description:
          '面向企业客服的 Agentic RAG 项目。我在这里探索 RAG、对话、工单、知识库以及 trace / observability 如何组成可追踪的工程流程；它保留了从知识到服务的系统实践。',
        links: [
          {
            type: 'github',
            href: 'https://github.com/yftx293/enterprise-customer-service-agentic-rag'
          }
        ]
      },
      {
        id: 'qiniu_xengineer_ai_pr_review',
        name: 'qiniu-xengineer-ai-pr-review',
        description:
          'AI PR Review 项目。我在这里探索 GitHub PR 获取、diff 风险分析、AI review 与展示流程如何衔接；它保留了将 review 变成可查看流程的实践。',
        links: [
          {
            type: 'github',
            href: 'https://github.com/yftx293/qiniu-xengineer-ai-pr-review'
          }
        ]
      }
    ]}
  />
</PageLayout>
