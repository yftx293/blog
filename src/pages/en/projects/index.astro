---
import PageLayout from '@/layouts/CommonPage.astro'
import GitHubContributions from '@/components/projects/GitHubContributions.astro'
import ProjectReferences from '@/components/projects/ProjectReferences.astro'
import ProjectSection from '@/components/projects/ProjectSection.astro'

export const prerender = true

const headings = [
  { depth: 2, slug: 'projects', text: 'Projects' },
  { depth: 2, slug: 'learnings', text: 'Learnings' },
  { depth: 2, slug: 'theme', text: 'Theme' }
]
---

<PageLayout title='Projects' {headings} info={{ slug: '/en/projects', hideComment: true }}>
  <p>GitHub activities</p>
  <GitHubContributions username='yftx293' />

  <h2 id='projects'>Projects</h2>
  <p>
    Projects I am exploring, iterating on, and keeping for the engineering questions they reveal.
  </p>
  <ProjectSection
    analyticsSection='projects'
    showFullDescription
    project={[
      {
        id: 'ai-native-crm',
        name: 'AiNativeCrm',
        description:
          'An agent-native workbench with CRM as its state space. It explores how agents use tools to advance customer, opportunity, and task workflows within permission, approval, and budget boundaries, preserving the trade-offs between knowledge, memory, execution replay, and evaluation.',
        links: [{ type: 'github', href: 'https://github.com/yftx293/AiNativeCrm' }]
      },
      {
        id: 'miniclaw',
        name: 'miniclaw',
        description:
          'A self-hosted, multi-channel workbench powered by Pi Agent. It explores how workspaces, persistent sessions, memory, and tool permissions support long-running agents, with one runtime shared by web, desktop, and messaging channels; it preserves the practice of execution boundaries and background tasks.',
        links: [
          {
            type: 'github',
            href: 'https://github.com/yftx293/miniclaw'
          }
        ]
      },
      {
        id: 'folio',
        name: 'folio',
        description:
          'A local-first AI investment research workbench. It explores how market data, agents, and evidence connect to research reports and changing theses, preserving the practice of capability registration, offline fallback, and evaluation. It is a read-only research tool, with no order placement or trading functionality.',
        links: [
          {
            type: 'github',
            href: 'https://github.com/yftx293/folio'
          }
        ]
      }
    ]}
  />
  <ProjectReferences />
</PageLayout>
