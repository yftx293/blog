---
import PageLayout from '@/layouts/CommonPage.astro'
import GitHubContributions from '@/components/projects/GitHubContributions.astro'
import ProjectReferences from '@/components/projects/ProjectReferences.astro'
import ProjectSection from '@/components/projects/ProjectSection.astro'

export const prerender = true

const headings = [
  { depth: 2, slug: 'projects', text: 'Projects' },
  { depth: 2, slug: 'learnings', text: 'Learnings' },
  { depth: 2, slug: 'theme', text: 'Theme' }
]
---

<PageLayout title='Projects' {headings} info={{ slug: '/en/projects', hideComment: true }}>
  <p>GitHub activities</p>
  <GitHubContributions username='yftx293' />

  <h2 id='projects'>Projects</h2>
  <p>
    Projects I am exploring, iterating on, and keeping for the engineering questions they reveal.
  </p>
  <ProjectSection
    analyticsSection='projects'
    showFullDescription
    project={[
      {
        id: 'tinycode',
        name: 'tinycode',
        description:
          'A lightweight TypeScript coding agent built on Pi Agent Core. I explore how CLI, permissions, sessions, context, skills, MCP, and read-only sub-agents work together; the project keeps a record of those engineering trade-offs.',
        links: [{ type: 'github', href: 'https://github.com/yftx293/tinycode' }]
      },
      {
        id: 'enterprise_customer_service_agentic_rag',
        name: 'enterprise-customer-service-agentic-rag',
        description:
          'An Agentic RAG project for enterprise customer service. I explore how RAG, conversations, tickets, knowledge bases, and trace / observability form a traceable workflow; it preserves the practice of connecting knowledge to a service.',
        links: [
          {
            type: 'github',
            href: 'https://github.com/yftx293/enterprise-customer-service-agentic-rag'
          }
        ]
      },
      {
        id: 'qiniu_xengineer_ai_pr_review',
        name: 'qiniu-xengineer-ai-pr-review',
        description:
          'An AI PR review project. I explore the connection between GitHub PR retrieval, diff risk analysis, AI review, and presentation; it preserves the practice of making reviews inspectable.',
        links: [
          {
            type: 'github',
            href: 'https://github.com/yftx293/qiniu-xengineer-ai-pr-review'
          }
        ]
      }
    ]}
  />
  <ProjectReferences />
</PageLayout>
