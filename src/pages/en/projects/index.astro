---
import PageLayout from '@/layouts/CommonPage.astro'
import GitHubContributions from '@/components/projects/GitHubContributions.astro'
import ProjectSection from '@/components/projects/ProjectSection.astro'

export const prerender = true

const headings = [{ depth: 2, slug: 'projects', text: 'Projects' }]
---

<PageLayout title='Projects' {headings} info={{ slug: '/en/projects', hideComment: true }}>
  <p>GitHub activity</p>
  <GitHubContributions username='yftx293' />

  <h2 id='projects'>Projects</h2>
  <p>Projects I am still exploring, improving, or returning to.</p>
  <ProjectSection
    analyticsSection='projects'
    showFullDescription
    project={[
      {
        id: 'tinycode',
        name: 'tinycode',
        description:
          'A lightweight TypeScript coding agent built on Pi Agent Core. I use it to explore how a CLI, permissions, sessions, context, skills, MCP, and read-only subagents fit together.',
        links: [{ type: 'github', href: 'https://github.com/yftx293/tinycode' }]
      },
      {
        id: 'enterprise_customer_service_agentic_rag',
        name: 'enterprise-customer-service-agentic-rag',
        description:
          'An agentic RAG project for enterprise customer support, connecting retrieval, conversations, tickets, a knowledge base, and traceability.',
        links: [
          {
            type: 'github',
            href: 'https://github.com/yftx293/enterprise-customer-service-agentic-rag'
          }
        ]
      },
      {
        id: 'qiniu_xengineer_ai_pr_review',
        name: 'qiniu-xengineer-ai-pr-review',
        description:
          'An AI PR review project exploring how GitHub pull requests, diff risk analysis, automated review, and readable results connect.',
        links: [{ type: 'github', href: 'https://github.com/yftx293/qiniu-xengineer-ai-pr-review' }]
      }
    ]}
  />
</PageLayout>
