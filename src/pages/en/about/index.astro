---
import PageLayout from '@/layouts/CommonPage.astro'
import AboutContent from '@/components/about/AboutContent.astro'
import Comment from '@/components/comment/Comment.astro'

const headings = [
  { depth: 2, slug: 'about-me', text: 'About me' },
  { depth: 2, slug: 'current-focus', text: 'Current focus' },
  { depth: 2, slug: 'about-blog', text: 'About this blog' },
  ...(__JOJO__ ? [{ depth: 2, slug: 'jojo', text: 'Jojo' }] : []),
  { depth: 2, slug: 'social-networks', text: 'GitHub' },
  { depth: 2, slug: 'tools', text: 'Tools & references' },
  { depth: 2, slug: 'technical-notes', text: 'Technical directions' }
]
---

<PageLayout title='About' {headings} info='/en/about'>
  <AboutContent lang='en' />
  <Comment class='mt-8' path='/about' />
</PageLayout>
