---
import PageLayout from '@/layouts/CommonPage.astro'

export const prerender = true

const headings = [
  { depth: 2, slug: 'about-me', text: 'About me' },
  { depth: 2, slug: 'current-focus', text: 'Current focus' },
  { depth: 2, slug: 'about-blog', text: 'About this blog' }
]
---

<PageLayout title='About' {headings} info='/en/about'>
  <h2 id='about-me'>About me</h2>
  <p>I'm an undergraduate studying Information and Computing Science.</p>

  <h2 id='current-focus'>Current focus</h2>
  <p>
    I'm exploring AI agents, coding agents, LLM applications, and the engineering systems around
    them. I'm also learning backend development and AI infrastructure.
  </p>

  <h2 id='about-blog'>About this blog</h2>
  <p>
    This is where I record what I learn from projects, source code, and ideas that are still taking
    shape.
  </p>
</PageLayout>
