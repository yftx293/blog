---
import links from 'public/links.json'

import PageLayout from '@/layouts/CommonPage.astro'
import FriendConstellation from '@/components/links/FriendConstellation.astro'

export const prerender = true

const headings = [{ depth: 2, slug: 'websites', text: 'Websites & links' }]
---

<PageLayout title='Links' {headings} info='/en/links'>
  <p>
    Personal websites, projects, and places worth revisiting. This retained directory does not imply
    personal friendships or exchanged links.
  </p>
  <h2 id='websites'>Websites & links</h2>
  <FriendConstellation list={links.friends[0]} meLabel='Yu' />
</PageLayout>
