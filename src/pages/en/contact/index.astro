---
import PageLayout from '@/layouts/CommonPage.astro'

export const prerender = true

const headings = [{ depth: 2, slug: 'github', text: 'Find me on GitHub' }]
---

<PageLayout title='Contact' {headings} info='/en/contact'>
  <p>
    If you'd like to discuss AI agents, coding agents, engineering, or something on this blog, you
    can reach me on GitHub.
  </p>

  <h2 id='github'>Find me on GitHub</h2>
  <p>
    <a href='https://github.com/yftx293' target='_blank' rel='noopener noreferrer'
      >github.com/yftx293</a>
  </p>
  <p>GitHub is the only contact method I currently share here.</p>
</PageLayout>
