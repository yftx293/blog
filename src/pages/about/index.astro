---
import PageLayout from '@/layouts/CommonPage.astro'
import AboutContent from '@/components/about/AboutContent.astro'
import Comment from '@/components/comment/Comment.astro'

const headings = [
  { depth: 2, slug: 'about-me', text: '关于我' },
  { depth: 2, slug: 'current-focus', text: '当前关注' },
  { depth: 2, slug: 'about-blog', text: '关于这个博客' },
  ...(__JOJO__ ? [{ depth: 2, slug: 'jojo', text: 'Jojo' }] : []),
  { depth: 2, slug: 'social-networks', text: 'GitHub' },
  { depth: 2, slug: 'tools', text: '工具与参考' },
  { depth: 2, slug: 'technical-notes', text: '技术方向' }
]
---

<PageLayout title='About' {headings} info='/about'>
  <AboutContent lang='zh' />
  <Comment class='mt-8' path='/about' />
</PageLayout>
