    {
      name: 'ChatGPT',
      description: 'AI Assistant',
      href: 'https://chat.openai.com/',
      icon: import('@/assets/tools/chatgpt.svg?raw')
    },
    {
      name: 'Claude Code',
      description: 'AI Coding Assistant',
      href: 'https://claude.ai/',
      icon: import('@/assets/tools/claude.svg?raw')
    },
    {
      name: 'Codex',
      description: 'Agentic Coding CLI',
      href: 'https://openai.com/codex/',
      icon: import('@/assets/tools/openai.svg?raw')
    },
    {
      name: 'OpenClaw',
      description: 'Personal AI Assistant',
      href: 'https://openclaw.ai',
      icon: import('@/assets/tools/openclaw.svg?raw')
    },
    {
      name: 'Hermes',
      description: 'Self-Improving AI Agent',
      href: 'https://hermes-agent.nousresearch.com',
      icon: hermesIcon
    },
    {
      name: 'v0 by Vercel',
