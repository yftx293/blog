---
import { cn } from 'astro-pure/utils'

const { class: className, title, ...attrs } = Astro.props
---

<section
  class={cn('home-section flex flex-col gap-y-5 md:flex-row md:gap-y-0', className)}
  {...attrs}
>
  <div class='text-xl font-semibold md:min-w-36'>
    <h2>{title}</h2>
  </div>
  <div class='flex flex-1 flex-col gap-y-3'>
    <slot />
  </div>
</section>

<style>
  .home-section {
    padding-top: 1.75rem;
    border-top: 1px solid hsl(var(--border) / 0.7);
  }
  .home-section h2 {
    line-height: 1.4;
    letter-spacing: -0.015em;
  }
  .home-section > div:last-child {
    min-width: 0;
    line-height: 1.8;
  }
  @media (max-width: 640px) {
    .home-section {
      padding-top: 1.25rem;
    }
  }
</style>
