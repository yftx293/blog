---
import { cn } from 'astro-pure/utils'

interface Props {
  class?: string
  href: string
  heading: string
  subheading?: string
  date?: string
  target?: string
  [key: string]: unknown
}

const {
  class: className,
  href,
  heading,
  subheading,
  date,
  target = '_blank',
  ...props
} = Astro.props
---

<a
  href={href}
  target={target}
  rel={target === '_blank' ? 'noopener noreferrer' : undefined}
  {...props}
  class={cn(
    'link-card not-prose block relative rounded-2xl border bg-muted px-5 py-3 no-underline',
    className
  )}
>
  <div class='flex flex-col gap-y-1.5'>
    <div class='flex flex-col gap-y-0.5'>
      <div class='link-card-heading'>
        <h3 class='text-lg font-medium'>{heading}</h3>
        <svg
          class='link-card-arrow'
          width='18'
          height='18'
          viewBox='0 0 24 24'
          fill='none'
          stroke='currentColor'
          stroke-width='1.5'
          stroke-linecap='round'
          stroke-linejoin='round'
          aria-hidden='true'
        >
          <path d={target === '_blank' ? 'M7 17 17 7M7 7h10v10' : 'M5 12h14m-6-6 6 6-6 6'}></path>
        </svg>
      </div>
      {subheading && <p class='text-muted-foreground'>{subheading}</p>}
      {date && <p class='link-card-meta text-muted-foreground'>{date}</p>}
    </div>
    <slot />
  </div>
</a>

<style>
  .link-card {
    padding: 1.25rem 1.5rem;
    background: hsl(var(--card) / 0.65);
    transition:
      background-color 220ms ease,
      border-color 220ms ease;
  }
  .link-card-heading {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 0.4rem;
  }
  .link-card h3 {
    overflow-wrap: anywhere;
    letter-spacing: -0.015em;
  }
  .link-card p {
    font-size: 0.9rem;
    line-height: 1.8;
  }
  .link-card .link-card-meta {
    margin-top: 0.65rem;
    font-size: 0.75rem;
    font-variant-numeric: tabular-nums;
  }
  .link-card-arrow {
    flex-shrink: 0;
    color: hsl(var(--muted-foreground));
    transition:
      transform 240ms var(--ease-out),
      color 180ms ease;
  }
  .link-card:where(:hover, :focus-visible) {
    background: hsl(var(--muted) / 0.6);
    border-color: hsl(var(--primary) / 0.5);
  }
  .link-card:where(:hover, :focus-visible) .link-card-arrow {
    color: hsl(var(--primary));
    transform: translate(2px, -2px);
  }
  @media (prefers-reduced-motion: reduce) {
    .link-card,
    .link-card-arrow {
      transition: none;
    }
    .link-card:where(:hover, :focus-visible) .link-card-arrow {
      transform: none;
    }
  }
</style>
